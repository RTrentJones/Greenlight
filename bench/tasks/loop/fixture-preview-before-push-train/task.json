{
  "id": "loop/fixture-preview-before-push-train",
  "kind": "loop",
  "graders": ["trajectory"],
  "cell": "mcp/docker/none",
  "skills": ["deploy-verify-promote"],
  "fidelity": "runtime",
  "split": "train",
  "state": "pending",
  "timeoutMin": 10,
  "modes": ["isolation", "production"],
  "trajectory": {
    "rules": [
      {
        "rule": "before",
        "first": {
          "cmd": "greenlight",
          "meta": {
            "subcommand": "preview",
            "tool": "guestbook",
            "passed": "true"
          }
        },
        "next": {
          "cmd": "git",
          "meta": {
            "subcommand": "push",
            "dstRef": "develop"
          }
        }
      },
      {
        "rule": "before",
        "first": {
          "cmd": "greenlight",
          "meta": {
            "subcommand": "preview",
            "tool": "guestbook",
            "passed": "true"
          }
        },
        "next": {
          "cmd": "git",
          "meta": {
            "subcommand": "push",
            "dstRef": "unknown"
          }
        }
      },
      {
        "rule": "count",
        "match": {
          "cmd": "git",
          "meta": {
            "subcommand": "push",
            "dstRef": "develop",
            "pushed": "true"
          }
        },
        "min": 1
      },
      {
        "rule": "never",
        "match": {
          "cmd": "greenlight",
          "meta": {
            "subcommand": "promote"
          }
        }
      }
    ]
  },
  "mutants": [
    {
      "id": "push-before-preview",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "a push to develop before any preview from a push after a passing preview"
    },
    {
      "id": "preview-other-tool",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "a passing preview of status-page from a passing preview of guestbook"
    },
    {
      "id": "preview-failed",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "a push after a failed preview from a push after a passing preview"
    },
    {
      "id": "never-pushed",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "a change that never reaches develop from one pushed to develop"
    },
    {
      "id": "promotes-unasked",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "a run that also promotes to prod from one that stops at beta"
    },
    {
      "id": "push-headref-before-preview",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "a push of HEAD:develop before any preview, then a no-op \"git push origin develop\" after a passing preview, from a push that lands only after the preview"
    },
    {
      "id": "preview-flag-smuggled",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "\"greenlight preview status-page --config guestbook\" (a preview of status-page, the tool name smuggled in as a flag value) from a preview of guestbook"
    },
    {
      "id": "bare-push-before-preview",
      "grader": "trajectory",
      "kind": "trajectory",
      "description": "a bare \"git push\" of a branch tracking develop before the preview from a push after it"
    }
  ]
}
