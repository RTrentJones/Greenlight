{
  "ctx": {
    "branch": "develop",
    "upstreams": {
      "develop": {
        "remote": "origin",
        "ref": "develop"
      },
      "feat/x": {
        "remote": "origin",
        "ref": "develop"
      }
    }
  },
  "events": [
    {
      "transcript": "read_file",
      "argv": ["tools/pinboard/app.mjs"]
    },
    {
      "transcript": "write_file",
      "argv": ["tools/pinboard/app.mjs"]
    },
    {
      "cmd": "git",
      "argv": ["switch", "develop"]
    },
    {
      "cmd": "git",
      "argv": ["add", "tools/pinboard/app.mjs"]
    },
    {
      "cmd": "git",
      "argv": ["commit", "-m", "pinboard: update copy"]
    },
    {
      "cmd": "git",
      "argv": ["p", "origin", "HEAD:develop"],
      "ctx": {
        "remoteMoved": true,
        "env": {
          "GIT_CONFIG_COUNT": "1",
          "GIT_CONFIG_KEY_0": "alias.p",
          "GIT_CONFIG_VALUE_0": "push"
        }
      }
    },
    {
      "cmd": "greenlight",
      "argv": ["preview", "pinboard"]
    },
    {
      "cmd": "git",
      "argv": ["push", "origin", "develop"],
      "ctx": {
        "remoteMoved": false
      }
    },
    {
      "cmd": "greenlight",
      "argv": ["verify", "pinboard", "--env", "beta"]
    }
  ]
}
