{
  "name": "@rtrentjones/greenlight-wiki",
  "version": "0.10.1",
  "private": true,
  "description": "Greenlight knowledge plane: wiki page, ledger, bench and evolution-loop schemas (vision 03 section 3).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RTrentJones/greenlight.git",
    "directory": "packages/wiki"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@rtrentjones/greenlight-shared": "workspace:*",
    "zod": "^3.24.1"
  }
}
